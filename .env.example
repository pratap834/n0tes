# NeonDB PostgreSQL Connection String
# Obtain this from your Neon Console (https://console.neon.tech):
# Format: postgresql://[user]:[password]@[endpoint-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pool.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require